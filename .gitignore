# Always track .gitkeep files so empty directories are preserved in git
!.gitkeep

# Data & Datasets (preserve directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.parquet
*.h5
*.hdf5

# Audio / Media files
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac

# Trained Models & Checkpoints (preserve directory structure via .gitkeep)
models/*
!models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.joblib
*.pb
*.tflite

# Generated Reports, Logs, and Visualizations
reports/*
!reports/.gitkeep
*.log
logs/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Environment variables & secrets
.env
.env.*
!.env.example

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
.directory

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
